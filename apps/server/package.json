{
  "name": "@comfyui-server/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "bundle": "node scripts/build.mjs",
    "start:bundle": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@comfyui-server/shared": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "esbuild": "0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
