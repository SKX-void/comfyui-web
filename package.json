{
  "name": "comfyui-web",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight frontend + workflow plugin host for ComfyUI: form → template render → ComfyUI API → progress → image",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SKX-void/comfyui-web.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm run build:plugins && pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:plugins": "pnpm -r --parallel --filter \"./plugins/*\" dev",
    "dev:web": "pnpm --filter @comfyui-web/web dev",
    "dev:host": "pnpm --filter @comfyui-web/server dev",
    "build": "pnpm run build:plugins && pnpm run build:host && pnpm run pack:dist",
    "build:host": "pnpm --filter @comfyui-web/web build && pnpm --filter @comfyui-web/server build",
    "build:plugins": "pnpm -r --filter \"./plugins/*\" build",
    "build:web": "pnpm --filter @comfyui-web/web build",
    "pack:dist": "node scripts/build-dist.mjs",
    "bundle:host": "pnpm --filter @comfyui-web/server bundle",
    "typecheck": "pnpm -r typecheck",
    "smoke": "pnpm --filter @comfyui-web/anima-plus smoke",
    "contract": "pnpm -r --filter \"./plugins/*\" test:contract",
    "verify": "node scripts/verify.mjs"
  },
  "packageManager": "pnpm@11.25.0"
}
