{
  // 宿主配置。文件不存在时全部走内置默认值（见 apps/server/src/config.ts）。
  // 每个字段的作用、环境变量覆盖、以及其余十几个"配置"文件的分工：docs/config.md
  // 端口 8087：宿主是唯一的后端（业务已全部搬进插件，不再有第二个进程）。
  "host": "0.0.0.0",
  "port": 8087,
  "dataDir": "data",
  "profilesDir": "profiles",
  "profile": "default",
  // tab 插件目录：每个子目录 = 一个自包含的工作流插件（目录名即 id，见 src/tabs.ts）
  "tabsDir": "tabs",
  "logLevel": "info"
}
