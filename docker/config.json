{
  // ===========================================================================
  // 容器内使用的配置（docker-compose.yml 会把它挂到 /app/config.json）
  //
  // 与仓库根那份 config.json 的区别：这里的路径都是**容器内**的，
  // host 必须是 0.0.0.0（容器里绑 127.0.0.1 的话，发布出去的端口连不上）。
  //
  // 环境变量优先级仍然更高，临时改一次可以用：
  //   COMFY_BASE_URL=other:8188 docker compose up -d
  // ===========================================================================

  "host": "0.0.0.0", // 容器内必须监听所有网卡
  "port": 8086, // 与 compose 的 ports 映射对应

  "comfyui": {
    // 局域网直连；如果 ComfyUI 也在 server-net 里，改成容器名 + 端口
    "baseUrl": "10.2.3.22:8188",
    "mode": "real"
  },

  // 模板不用配：它跟着产物走（dist/templates，与 server.mjs 版本锁定），
  // 默认就是"server.mjs 旁边的 templates/"。要热改模板再设 TEMPLATES_DIR。
  "dataDir": "/data", // 可写卷：SQLite
  "cacheDir": "/data/cache", // 可写卷：缩略图缓存（应用目录是只读的）

  "logLevel": "info",
  "mockStepDelayMs": 120
}
