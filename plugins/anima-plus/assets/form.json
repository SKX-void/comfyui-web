{
  "id": "txt2img-basic",
  "name": "基础文生图（WeiLin + Anima）",
  "description": "沿用拆分式节点设计：58（WeiLin Lora堆）只负责 LoRA 加载，19 负责主提示词，28/33 负责质量词，26 负责采样。触发词由本插件在提交时注入到 28 之前（plugins/anima-plus/docs/weilin.md §5.3 方案 B）。",
  "version": "1.0.0",
  "requirements": {
    "builtin": [
      "CLIPLoader",
      "CLIPTextEncode",
      "EmptyLatentImage",
      "UNETLoader",
      "VAEDecode",
      "VAELoader"
    ],
    "packs": [
      {
        "name": "WeiLin",
        "url": "https://github.com/weilin9999/WeiLin-Comfyui-Tools.git",
        "provides": [
          "WeiLinPromptUIOnlyLoraStack",
          "WeiLinPromptUIWithoutLora"
        ],
        "note": "提示词节点；LoRA 列表 / 标签 / 翻译也走它的接口（不在 ComfyUI-Manager 上）"
      },
      {
        "name": "Danbooru",
        "url": "https://github.com/Aaalice233/ComfyUI-Danbooru-Gallery.git",
        "provides": [
          "SaveImagePlus"
        ],
        "note": "出图节点（带 danbooru 元数据）"
      },
      {
        "name": "TeaCache",
        "url": "https://github.com/CocyNoric/ComfyUI-Anima-TeaCache.git",
        "provides": [
          "AnimaTeaCache"
        ]
      },
      {
        "name": "Enhancer",
        "url": "https://github.com/AdamNizol/ComfyUI-Anima-Enhancer.git",
        "provides": [
          "AnimaLayerReplayPatcher"
        ]
      },
      {
        "name": "Comfyroll",
        "url": "https://github.com/Suzie1/ComfyUI_Comfyroll_CustomNodes.git",
        "provides": [
          "CR Text"
        ]
      },
      {
        "name": "RES4LYF",
        "url": "https://github.com/ClownsharkBatwing/RES4LYF.git",
        "provides": [
          "ClownsharKSampler_Beta"
        ]
      }
    ],
    "weilin": true
  },
  "inputs": [
    {
      "key": "prompt",
      "label": "描述提示词",
      "type": "tag-selector",
      "required": true,
      "default": "1girl, solo, blue hair, looking at viewer",
      "ui": {
        "rows": 5,
        "placeholder": "输入提示词",
        "preset": "prompt"
      }
    },
    {
      "key": "qualityPos",
      "label": "质量词（正）",
      "type": "textarea",
      "required": false,
      "default": "dramatic angle,ultra-detailed,illustration,high resolution,an extremely delicate and beautiful,Accurate describe shapes,thorough and precise,bokeh,",
      "ui": {
        "rows": 3,
        "preset": "qualityPos",
        "collapsible": true,
        "collapsed": true
      }
    },
    {
      "key": "qualityNeg",
      "label": "质量词（负）",
      "type": "textarea",
      "required": false,
      "default": "blurry, soft focus, lowres, jpeg artifacts, chromatic aberration, artist name, oil painting, painterly, thick brushstrokes, impasto, canvas texture, traditional media, sketch, ugly, deformed, bad anatomy, bad hands, deformed hands, extra fingers, fused fingers, mutated hands, poorly drawn face, bad eyes, asymmetrical eyes,",
      "ui": {
        "rows": 3,
        "preset": "qualityNeg",
        "collapsible": true,
        "collapsed": true
      }
    },
    {
      "key": "loras",
      "label": "LoRA",
      "type": "lora-select",
      "required": false,
      "default": [],
      "ui": {
        "multiple": true
      }
    },
    {
      "key": "unet_name",
      "label": "主模型",
      "type": "model-select",
      "required": true,
      "default": "Anima\\0.26.9.12.NAI.RDBT  Anima.b1V23Base_fp16.safetensors",
      "source": {
        "kind": "comfy",
        "folder": "diffusion_models"
      }
    },
    {
      "key": "fileFormat",
      "label": "输出格式",
      "type": "select",
      "required": false,
      "default": "WEBP",
      "source": {
        "kind": "static",
        "options": [
          {
            "label": "PNG",
            "value": "PNG"
          },
          {
            "label": "WEBP",
            "value": "WEBP"
          },
          {
            "label": "JPEG",
            "value": "JPEG"
          }
        ]
      },
      "description": "PNG 会把完整工作流写进图片元数据（约 1.5MB）；WEBP 小 15 倍但不含正提示词"
    },
    {
      "key": "quality",
      "label": "输出质量",
      "type": "number",
      "required": false,
      "default": 80,
      "ui": {
        "min": 1,
        "max": 100,
        "step": 1
      },
      "visibleIf": {
        "key": "fileFormat",
        "notEquals": "PNG"
      },
      "description": "仅 WEBP / JPEG 生效"
    },
    {
      "key": "seed",
      "label": "种子",
      "type": "seed",
      "required": false,
      "default": 421066625562399,
      "ui": {
        "row": "seed"
      }
    },
    {
      "key": "randomSeed",
      "label": "随机",
      "type": "switch",
      "required": false,
      "default": true,
      "ui": {
        "row": "seed"
      }
    },
    {
      "key": "steps",
      "label": "步数",
      "type": "number",
      "required": false,
      "default": 20,
      "ui": {
        "min": 1,
        "max": 200,
        "step": 1,
        "row": "sampling"
      }
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "number",
      "required": false,
      "default": 1,
      "ui": {
        "min": 0,
        "max": 30,
        "step": 0.1,
        "row": "sampling"
      }
    },
    {
      "key": "width",
      "label": "宽",
      "type": "number",
      "required": false,
      "default": 832,
      "ui": {
        "min": 64,
        "max": 4096,
        "step": 8,
        "row": "size",
        "swap": "height",
        "preset": {
          "kind": "size",
          "targets": [
            "width",
            "height"
          ]
        }
      }
    },
    {
      "key": "height",
      "label": "高",
      "type": "number",
      "required": false,
      "default": 1216,
      "ui": {
        "min": 64,
        "max": 4096,
        "step": 8,
        "row": "size"
      }
    }
  ],
  "bindings": [
    {
      "target": "58.inputs.lora_str",
      "from": "loras",
      "transform": "weilinLora"
    },
    {
      "target": "28.inputs.text",
      "from": "qualityPos",
      "transform": "triggerPrefix"
    },
    {
      "target": "19.inputs.positive",
      "from": "prompt"
    },
    {
      "target": "33.inputs.text",
      "from": "qualityNeg"
    },
    {
      "target": "17.inputs.unet_name",
      "from": "unet_name"
    },
    {
      "target": "26.inputs.seed",
      "from": "seed",
      "transform": "seed"
    },
    {
      "target": "26.inputs.steps",
      "from": "steps"
    },
    {
      "target": "26.inputs.cfg",
      "from": "cfg"
    },
    {
      "target": "32.inputs.width",
      "from": "width"
    },
    {
      "target": "32.inputs.height",
      "from": "height"
    },
    {
      "target": "57.inputs.file_format",
      "from": "fileFormat"
    },
    {
      "target": "57.inputs.quality",
      "from": "quality"
    }
  ],
  "outputs": {
    "nodes": [
      "57"
    ],
    "type": "image"
  }
}
