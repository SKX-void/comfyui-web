node_modules/
dist/
.pnpm-store/
*.log
.DS_Store
.env
.env.local
*.tsbuildinfo
lib/

# （v1 的 config.local.json 规则已删：宿主只读 data/host.json，
#  本机覆盖只剩环境变量这一条路，见 apps/server/src/config.ts）

# 旧的缩略图缓存目录（现在默认放 <dataDir>/cache，这里只是别让历史文件冒出来）
.cache/

# 运行期数据：SQLite + 缩略图缓存；也是 docker-compose 的可写卷。
# 目录本身要留着（.gitkeep），内容不提交
/data/*
!/data/.gitkeep

# tabs/：宿主装载的**构建产物**（plugins/* → tabs/<id>/，D16）。可复现（重建 16/16 字节一致）
# 且体积大，不入库；仓库只留目录说明（tabs/README.md）。见 docs/architecture.md §4.1
/tabs/*/

# 前端 import map 的 vendor 产物（由 scripts/vendor.mjs 从 node_modules 复制）
/apps/web/public/vendor/
