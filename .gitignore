node_modules/
dist/
.pnpm-store/
*.log
.DS_Store
.env
.env.local
*.tsbuildinfo
lib/

# 本机私密配置（覆盖 config.json）
config.local.json

# 旧的缩略图缓存目录（现在默认放 <dataDir>/cache，这里只是别让历史文件冒出来）
.cache/

# 运行期数据：SQLite + 缩略图缓存；也是 docker-compose 的可写卷。
# 目录本身要留着（.gitkeep），内容不提交
/data/*
!/data/.gitkeep

# profile：plugins.yml 与 profile 的 package.json 提交，装进来的东西不提交
/profiles/*/node_modules/
/profiles/*/pnpm-lock.yaml
# 前端 import map 的 vendor 产物（由 scripts/vendor.mjs 从 node_modules 复制）
/apps/web/public/vendor/
