node_modules/
dist/
.pnpm-store/
*.log
.DS_Store
.env
.env.local
*.tsbuildinfo
lib/

# （v1 的 config.local.json 规则已删：v2 宿主只读 host.config.json，
#  本机覆盖只剩环境变量这一条路，见 apps/server/src/config.ts）

# 旧的缩略图缓存目录（现在默认放 <dataDir>/cache，这里只是别让历史文件冒出来）
.cache/

# 运行期数据：SQLite + 缩略图缓存；也是 docker-compose 的可写卷。
# 目录本身要留着（.gitkeep），内容不提交
/data/*
!/data/.gitkeep

# profile：profile 的 package.json 提交（插件集与 link 的基线），装进来的东西不提交
/profiles/*/node_modules/
/profiles/*/pnpm-lock.yaml
# 清单是**本机部署状态**（设置页会把本机 ComfyUI 地址等部署值写回它，跟随统一设置
# 那种也存解析后的地址，见 docs/architecture.md §6/§5.7），所以不入库。
# 入库的是基线模板 plugins.example.yml（`pnpm plugin snapshot` 生成），
# 宿主启动时清单缺失会从它复制一份（见 apps/server/src/index.ts）。
/profiles/*/plugins.yml
# 前端 import map 的 vendor 产物（由 scripts/vendor.mjs 从 node_modules 复制）
/apps/web/public/vendor/
