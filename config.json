{
  // ===========================================================================
  // comfyui-server 配置文件（支持 // 与 /* */ 注释）
  //
  // 优先级：环境变量 > config.local.json > config.json > 内置默认值
  // 若需本机私密配置，新建 config.local.json（已在 .gitignore 中）。
  // ===========================================================================

  // --- 本服务监听 ---
  "host": "127.0.0.1", // 需局域网访问时改为 "0.0.0.0"
  "port": 8086, // 前端 Vite 代理会自动读这个端口

  // --- ComfyUI 上游 ---
  "comfyui": {
    // 可写 "10.2.3.22:8188"，协议缺省补 http://
    "baseUrl": "10.2.3.22:8188",

    // "real" = 连接真实 ComfyUI；"mock" = 内置模拟器（无需 ComfyUI）
    "mode": "real"
  },

  // --- 其它 ---
  "templatesDir": "templates", // 相对仓库根目录
  "dataDir": ".data", // SQLite 等持久化数据（相对仓库根）
  "logLevel": "info", // fatal|error|warn|info|debug|trace
  "mockStepDelayMs": 120 // 仅 mock 模式：每步模拟耗时
}
