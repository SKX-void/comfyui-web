{
  // ===========================================================================
  // comfyui-server 配置（支持 // 与 /* */ 注释）
  //
  // **同一份文件同时给两种跑法用**：
  //   - 开发：pnpm dev:server（相对路径的基准 = 仓库根）
  //   - 容器：docker compose（基准 = /app，即挂进来的 dist 目录）
  // 所以容器部署可以直接把这四样东西复制到任意目录，一个字都不用改：
  //   docker-compose.yml / config.json / dist/ / data/
  //
  // 优先级：环境变量 > config.local.json > config.json > 内置默认值
  // ===========================================================================

  // --- 本服务监听 ---
  "host": "0.0.0.0", // 容器里必须绑所有网卡；开发模式也就顺便能从局域网直连 8086
  "port": 8086, // 前端 Vite 代理会自动读这个端口

  // --- ComfyUI 上游 ---
  "comfyui": {
    // 可写 "10.2.3.22:8188"，协议缺省补 http://
    "baseUrl": "10.2.3.22:8188",
    // 若 ComfyUI 也在 server-net 这个 docker 网络里，改成容器名 + 端口
    "mode": "real" // "real" = 连真实 ComfyUI；"mock" = 内置模拟器（无需 ComfyUI）
  },

  // --- 路径 ---
  // 相对路径一律以"根"为基准：开发时是仓库根，容器里是 /app。
  // 写相对路径，两种跑法就自动各就各位：
  //   开发  → <仓库根>/data
  //   容器  → /app/data（compose 把宿主机的 ./data 挂到这里）
  "dataDir": "data", // SQLite + 缩略图缓存
  // cacheDir 不用配：默认就是 <dataDir>/cache
  // templatesDir 也不用配：产物自带 templates/（与 server.mjs 版本锁定）

  // --- 其它 ---
  "logLevel": "info", // fatal|error|warn|info|debug|trace
  "mockStepDelayMs": 120 // 仅 mock 模式：每步模拟耗时
}
